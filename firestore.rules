rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /beaches/{beachId} { allow read: if true; allow write: if false; }
    match /weather_history/{recordId} { allow read: if true; allow write: if false; }
    match /activity_weights/{activityId} { allow read: if true; allow write: if false; }
    match /recommendation_history/{recordId} { allow create: if true; allow read: if false; }
    /* Existing application rules */
    match /groups/{groupCode}/members/{memberId} {
      allow read, write: if request.auth != null;
    }
    match /sosEvents/{sosId} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
